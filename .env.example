# LLM — obtenha em platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Câmera ESP32-CAM — URL base que o backend usa para buscar a foto.
# Padrão: http://findit-esp.local (mDNS). O .local só resolve quando a placa
# está ligada na MESMA rede e o resolvedor mDNS está disponível — o que NÃO
# acontece dentro de containers Docker / em produção. Nesses casos, use o IP
# fixo da placa (veja o IP no Serial Monitor após o boot), ex.:
# ESP32_URL=http://192.168.0.42
